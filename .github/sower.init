#!/bin/sh /etc/rc.common
# OpenWrt procd service for the sower client.
# install.sh rewrites PROG/CONF to the paths it installed into.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/sower
CONF=/etc/sower/sower.toml

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF"
	# The system resolver may point at this service, so respawn must be on.
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}
